<%- include('partials/head') %>
<body>
  <%- include('partials/nav') %>

  <main>
    <h1>Logg inn</h1>

    <% if (typeof error !== 'undefined' && error) { %>
      <p class="message message-error" role="alert"><%= error %></p>
    <% } %>

    <form action="/login" method="POST">
      <label for="username">Brukernavn</label>
      <input type="text"
             id="username"
             name="username"
             autocomplete="username"
             required>

      <label for="email">Skolemail</label>
      <input type="email"
             id="email"
             name="email"
             placeholder="navn@afk.no"
             pattern=".+@afk\.no"
             title="Skriv inn skolemailen din som slutter på @afk.no"
             autocomplete="email"
             required>

      <button type="submit">Logg inn</button>
    </form>
  </main>
</body>
</html>