<%- include('partials/head') %>
<body>
  <%- include('partials/nav') %>

  <main class="calendar-page">
    <div class="calendar-scene">
      <img class="scene-img" src="/css/images/chatsnobilde.jpg" alt="">

      <div class="calendar-content">
        <h1>Julekalender</h1>
        <p class="calendar-intro">Trykk på dagens luke for å se dagens oppgave.</p>

        <ul class="calendar">
          <% doors.forEach(function(door) { %>
            <li class="door-<%= door.status %>">
              <% if (door.status === 'locked') { %>
                <div class="door-inner" aria-disabled="true">
                  <span class="door-number"><%= door.day %></span>
                  <span class="door-label">Låst</span>
                </div>
              <% } else { %>
                <a class="door-inner" href="/luke/<%= door.day %>">
                  <span class="door-number"><%= door.day %></span>
                  <span class="door-label">Åpne</span>
                </a>
              <% } %>
            </li>
          <% }) %>
        </ul>
      </div>
    </div>
  </main>
</body>
</html>