<%- include('partials/head') %>
<body>
  <%- include('partials/nav') %>

  <main class="calendar-page">
    <div class="calendar-scene">
      <img class="scene-img" src="/css/images/chatsnobilde.jpg" alt="">

      <div class="calendar-content">
        <h1>Luke <%= doorNumber %></h1>
        <p class="quiz-question"><%= quiz.question %></p>

        <% if (quiz.type === 'video' && quiz.video_url) { %>
          <video controls src="<%= quiz.video_url %>"></video>
        <% } %>

        <form method="POST" action="/luke/<%= doorNumber %>/answer">
          <% if (quiz.type === 'multiple_choice' && quiz.options && quiz.options.length) { %>
            <% quiz.options.forEach(function(option) { %>
              <label>
                <input type="radio" name="answer" value="<%= option %>" required>
                <%= option %>
              </label>
            <% }) %>
          <% } else { %>
            <label for="answer">Ditt svar</label>
            <input type="text" id="answer" name="answer" required>
          <% } %>
          <button type="submit">Send svar</button>
        </form>
      </div>
    </div>
  </main>
</body>
</html>